{
  "name": "mediease-web",
  "version": "0.0.0",
  "private": true,
  "description": "MediEase web app — clinic dashboard, patient pages and ops console (Next.js)",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "e2e": "playwright test -c e2e",
    "gen:api": "openapi-typescript ../../contracts/openapi.yaml --immutable -o src/lib/api/schema.d.ts",
    "gen:api:check": "openapi-typescript ../../contracts/openapi.yaml --immutable -o src/lib/api/schema.d.ts --check"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "1.2.1",
    "motion": "14.4.0",
    "next": "16.4.3",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
