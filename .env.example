# MediEase environment settings.
# Copy to .env for local development:   cp .env.example .env
# Never commit .env. Every variable the code reads must be listed here with a comment.
# Values marked "change-me" are placeholders and are rejected outside APP_ENV=local.
# The "Used from" note says which milestone starts reading the variable.

# --- Application -------------------------------------------------------------
# local | test | staging | production                                  (Used from M0-P2)
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR — DEBUG is rejected in staging/production (M0-P2)
LOG_LEVEL=INFO
# SQL parameter logging. Must stay false in every environment; true fails start-up (M0-P2)
DB_ECHO_PARAMS=false

# --- Database (docker-compose `db` service) -----------------------------------
POSTGRES_USER=mediease
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=mediease
# Host port for local tools (psql, DB GUIs). Bound to 127.0.0.1 only.
POSTGRES_PORT=5432
# SQLAlchemy URL used by api, migrate and worker. Host is `db` inside compose.
# Required from M0-P2 (start-up fails with CFG_INVALID if missing); first queried in M0-P3.
# A change-me password is accepted only when APP_ENV=local.
DATABASE_URL=postgresql+psycopg://mediease:change-me-local-only@db:5432/mediease

# --- Service wiring ------------------------------------------------------------
API_PORT=8000
WEB_PORT=3000
# Where the Next.js server reaches the API on the internal network (M0-P4). Used for the
# server-side API client and the /api, /health, /ready rewrites; must be an absolute http(s)
# URL. `make dev-web` overrides it to http://localhost:${API_PORT}.
API_INTERNAL_URL=http://api:8000
# Public base URL used to build links we hand to people: staff invitations (M1-P5) and
# patient prescription links (M4). Must be absolute, and https outside local/test.
PUBLIC_BASE_URL=http://localhost:3000

# --- Auth and sessions (M1) ----------------------------------------------------
# false only for local http; must be true anywhere served over https.
# Validated from M0-P2: false is rejected when APP_ENV=staging or production.
COOKIE_SECURE=false
# HS256 key for access tokens (M1-P2). At least 32 characters in every environment; a value
# containing "change-me" is accepted only when APP_ENV=local. Changing it ends every session.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=change-me-local-only-jwt-signing-key-001
# HMAC key for the IP fingerprints stored on audit events (M1-P4). Same rules as above.
# Rotating it makes fingerprints recorded earlier incomparable with later ones.
AUDIT_IP_SALT=change-me-local-only-audit-ip-salt-001
# Access token (me_access cookie) lifetime, 60-3600 s (M1-P2)
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token (me_refresh cookie) lifetime, 3600-2592000 s; renewed on every refresh (M1-P2)
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Patient links (M4-P5, spec R9) -------------------------------------------------
# Comma-separated kid:secret pairs (kid: 1-16 letters, digits, - or _). The first signs new links;
# all verify, so rotate by putting a new key first and dropping the old one 90 days later.
# Each secret at least 32 characters; a change-me value is accepted only in local and test, and
# an empty value there means a built-in development key. Required in staging and production.
# Generate: python3 -c "import secrets; print('k1:' + secrets.token_urlsafe(48))"
PATIENT_LINK_SIGNING_KEYS=k1:change-me-local-only-patient-link-key-001
# How long a link lasts, 1-90 days
PATIENT_LINK_TTL_DAYS=90

# --- Blob storage (M4-P4, ADR-0012) --------------------------------------------------
# Where generated files (prescription PDFs) are kept. local: a directory, in compose the
# `blobs` volume at /var/lib/mediease/blobs (fixed in docker-compose.yml; BLOB_LOCAL_DIR
# changes it outside compose). s3: an S3-compatible bucket (production from M6) that blocks
# public access; credentials come from the standard AWS chain (AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY, or an instance role), never from this file.
BLOB_STORAGE=local
# Required when BLOB_STORAGE=s3
S3_BUCKET=
S3_REGION=ap-south-1
# Empty for AWS; the endpoint URL of another S3-compatible store otherwise
S3_ENDPOINT_URL=

# --- Background worker (M5-P1) -------------------------------------------------
# Seconds the worker sleeps when no job is due (1-60) and jobs it claims per poll (1-100)
WORKER_POLL_SECONDS=2
WORKER_BATCH_SIZE=10

# --- Messaging (M5) ------------------------------------------------------------
# console (M5-P2: logs instead of sending; the worker refuses it in production) | whatsapp_cloud (P3)
MESSAGING_PROVIDER=console
MESSAGING_SMS_FALLBACK_ENABLED=false
# Fernet keys for the phone numbers stored on messages (M5-P2), comma-separated: the first
# encrypts, all decrypt. Empty in local/test uses a fixed development key; required when deployed.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MESSAGING_PHONE_KEYS=
# A prescription link is sent only within this many hours of issue, 1-24 (prescriptions R15)
RX_LINK_SEND_WINDOW_HOURS=24
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
# SMS provider (DLT-registered) — adapter chosen in M5-P5
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Clinic defaults -----------------------------------------------------------
DEFAULT_CLINIC_TIMEZONE=Asia/Kolkata
QUIET_HOURS_START=21:00
QUIET_HOURS_END=08:00
