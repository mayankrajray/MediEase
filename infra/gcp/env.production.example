# Production settings for the Compute Engine VM (M9-P1; RUNBOOK §38). Names and fixed values only.
# infra/gcp/new-env.sh copies this to /opt/mediease/.env, fills every internal secret with a new
# random value and makes the file owner-only. Then fill the empty values below by hand
# (`nano .env`), and check with: make config-check LIVE=1
# An empty required value stops the app with CFG_INVALID naming it, so nothing runs half-set.

# Both compose files, for every make target and docker compose command on the VM.
COMPOSE_FILE=docker-compose.yml:infra/gcp/docker-compose.prod.yml

APP_ENV=production
LOG_LEVEL=INFO
# The site's name (Caddy's certificate) and the links we hand out. mediease.care from December.
PUBLIC_HOST=mediease.duckdns.org
PUBLIC_BASE_URL=https://mediease.duckdns.org
COOKIE_SECURE=true

# --- Database (in Docker on this VM) -----------------------------------------------------
POSTGRES_USER=mediease
POSTGRES_DB=mediease
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
DATABASE_URL=postgresql+psycopg://mediease:__POSTGRES_PASSWORD__@db:5432/mediease

# --- Internal secrets (generated by new-env.sh; never reuse local ones) ------------------
JWT_SIGNING_KEY=__GENERATE__
AUDIT_IP_SALT=__GENERATE__
PATIENT_LINK_SIGNING_KEYS=k1:__GENERATE__
MESSAGING_PHONE_KEYS=__FERNET__
# Caddy writes the visitor's address in X-Forwarded-For; the web app passes it on with this.
TRUSTED_PROXY_SECRET=__GENERATE__
CLIENT_IP_HEADER=x-forwarded-for
PUBLIC_READS_PER_MINUTE=60

# --- Messaging: off until Meta allows WhatsApp sending (decision 1) ----------------------
MESSAGING_PROVIDER=disabled
MESSAGING_SMS_FALLBACK_ENABLED=false

# --- Files and backups -------------------------------------------------------------------
BLOB_STORAGE=local
# FILL: the backup bucket's name, without gs:// (scripts/backup.sh reads only this line).
BACKUP_BUCKET=

# --- Email through Brevo (port 587; Compute Engine blocks only port 25) ------------------
EMAIL_PROVIDER=smtp
# FILL: a sender verified in Brevo, e.g. MediEase <name@example.com>
EMAIL_FROM=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
# FILL: Brevo → SMTP & API → SMTP login and an SMTP key.
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Google sign-in ----------------------------------------------------------------------
# Redirect URI to register: https://mediease.duckdns.org/api/v1/auth/google/callback
GOOGLE_OIDC_PROVIDER=google
# FILL: the OAuth client's ID and secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- The assistant (decision 2: Groq, with the caveat accepted) --------------------------
LLM_PROVIDER=groq
# FILL: the Groq API key.
LLM_API_KEY=
LLM_PATIENT_DATA_ALLOWED=true

# --- Web push ----------------------------------------------------------------------------
PUSH_PROVIDER=webpush
# FILL: a NEW pair from `make vapid-keys` on this VM (not the local one).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# FILL: mailto: and the sender address above.
VAPID_SUBJECT=
