{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make ps)",
      "Bash(make lint:*)",
      "Bash(make typecheck:*)",
      "Bash(make test:*)",
      "Bash(make test-api:*)",
      "Bash(make test-web:*)",
      "Bash(make contract:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(make down:*)",
      "Bash(make migrate:*)",
      "Bash(docker compose down:*)",
      "Bash(docker volume rm:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(cat .env:*)"
    ]
  }
}
